	"description": "Move items in inventory GUIs by scrolling the mouse wheel or dragging over slots. Crafting Fix build for 1.21.11, based on Andrews54757's itemscroller-crafting-fix.",
	"authors": [
		"masa"
	],
	"contributors": [
		"Sakura-Ryoko",
		"Andrews54757",
		"KanetyEngineer"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/item-scroller",
		"issues": "https://github.com/KanetyEngineer/itemscroller-crafting-fix/issues",
		"sources": "https://github.com/KanetyEngineer/itemscroller-crafting-fix",
		"twitter": "https://twitter.com/maruohon",
		"discord": "https://discordapp.com/channels/211786369951989762/453662800460644354/"
	},

	"license": "LGPLv3",
	"icon": "assets/itemscroller/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"fi.dy.masa.itemscroller.ItemScroller"
